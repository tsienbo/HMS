# Copy to /etc/hms/hms.env (root-owned, chmod 600). Use actual database credentials.
HMS_DB_HOST=127.0.0.1
HMS_DB_PORT=5432
HMS_DB_USER=hms
HMS_DB_PASSWORD=REPLACE_ME
PGDATABASE=hospital_registration

# Configure a real mailbox to enable delivery. Until then email stays pending.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_DRY_RUN=1
